# Template for the per-environment .env files. Copy to one of:
#   .env.production.medecinelibre.com
#   .env.staging.medecinelibre.com
#   .env.dev.medecinelibre.com
#
# These are gitignored (.env*) and therefore NOT on a fresh clone — copy
# them from another machine or recreate them from this template before
# building.
#
# PUBLIC_PLAUSIBLE_SCRIPT_SRC and PUBLIC_GOOGLE_SITE_VERIFICATION are read
# via $env/static/public, i.e. compiled into the bundle at build time by
# whichever file the build's ENV_FILE points at. Leave them empty for any
# environment that is not the real site.

DOCKER_IMAGE_NAME=ghcr.io/medica-im/medecinelibre:production
VITE_DEV=false
PUBLIC_SITE_TITLE=Médecine Libre
ORIGIN=https://medecinelibre.com
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_PLAUSIBLE_SCRIPT_SRC=
#docker compose
NODE_PORT_EXTERNAL_PRODUCTION=3004
